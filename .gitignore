app_config.dart
config/
secrets/

# Firebase configuration files (if you haven't already)
firebase_options.dart
google-services.json
GoogleService-Info.plist

# Environment files
.env
.env.local
.env.production

# API keys and secrets
**/api_keys.dart
**/secrets.dart
**/config.dart
**/*_secrets.dart
**/*_config.dart

# Any files containing sensitive data
sensitive_data/

# These checked-in files contain placeholders only; keep real Firebase config local.
!lib/app_config.dart
!lib/firebase_options.dart
